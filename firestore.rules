rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc used to verify Firestore connectivity
    match /test/connection {
      allow read: if true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Rural Immersion Programme Expenses
    match /expenses/{expenseId} {
      allow read: if true;
      allow create, update: if isValidId(expenseId)
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 100
        && request.resource.data.vendor is string
        && request.resource.data.vendor.size() <= 200
        && request.resource.data.paidByFaculty is string
        && request.resource.data.paidByFaculty.size() <= 200;
      allow delete: if isValidId(expenseId);
    }

    // Rural Immersion Cohort Trips
    match /trips/{tripId} {
      allow read: if true;
      allow create, update: if isValidId(tripId)
        && request.resource.data.tripCode is string
        && request.resource.data.tripCode.size() <= 100
        && request.resource.data.budget is number;
      allow delete: if isValidId(tripId);
    }

    // Active Camp Configuration
    match /camps/{campId} {
      allow read: if true;
      allow write: if isValidId(campId);
    }

    // Faculty Roster
    match /faculty/{facultyId} {
      allow read: if true;
      allow write: if isValidId(facultyId);
    }

    // Registered Institutional Users (Managed by Admin Department)
    match /registered_users/{userId} {
      allow read: if true;
      allow write: if isValidId(userId);
    }

    // Statement Clearances & Signatures
    match /signatures/{tripCode} {
      allow read: if true;
      allow write: if isValidId(tripCode);
    }
  }
}
